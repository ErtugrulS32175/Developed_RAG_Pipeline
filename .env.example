# --- Database ---
PG_DSN=postgresql://rag:CHANGE_ME@localhost:5433/ragdb
OUTPUT_DIR=./output
UPLOAD_DIR=./data/uploads

# --- API auth ---
# Shared secret for pipeline/api.py. When empty the API is UNAUTHENTICATED and
# says so at startup -- fine bound to localhost, never acceptable beyond it.
# In OpenWebUI, enter the same value as the connection's API key.
API_KEY=
LOG_LEVEL=INFO

# --- Ingest ---
# Chunks shorter than this are folded into a neighbour on the same page: below
# roughly this length a fragment loses the subject that makes it findable.
MIN_CHUNK_CHARS=100
MAX_CHUNK_CHARS=2500
# The embedding service is called once per chunk; a transient failure is
# retried with a growing pause rather than abandoning the whole run.
INGEST_RETRY_ATTEMPTS=4
INGEST_RETRY_BACKOFF=2.0
# BM25 stems Turkish. fastembed's default is English, which leaves inflected
# forms of the same word unmatched. Changing this requires a re-ingest.
BM25_LANGUAGE=turkish

# --- Hugging Face ---
# Optional. Anonymous downloads are rate-limited, which on a fresh machine can
# stall a multi-GB model fetch; a read-scope token removes that. Nothing here is
# gated, so an existing install with cached weights does not need it.
HF_TOKEN=
# Skips the chunked-then-reassembled download path, which needs roughly twice
# the disk of the model itself and has exhausted quota on a fresh box before.
HF_HUB_DISABLE_XET=1

# --- Embedding + reranker (vLLM, OpenAI-compatible) ---
EMBED_API_URL=http://localhost:8011/v1/embeddings
EMBED_MODEL_NAME=BAAI/bge-m3
RERANK_API_URL=http://localhost:8002/v1/score
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# --- Question-answering engine ---
# native     = the pipeline in this repo (pgvector hybrid search + RRF + reranker)
# llamaindex = LlamaIndex over the same chunks, as a second opinion. Optional:
#              pip install -r requirements-llamaindex.txt
#              python -m pipeline.rag_llamaindex build
# Also selectable per conversation in OpenWebUI via the ragtest-rag-llamaindex
# model, and per run in the eval harness with --backend.
RAG_BACKEND=native
LLAMAINDEX_TABLE=llamaindex_chunks
LLAMAINDEX_TOP_K=15
EMBED_DIM=1024

# --- LLM (any OpenAI-compatible chat endpoint; swap freely by URL) ---
LLM_API_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL_NAME=Qwen/Qwen3-14B

# --- OCR service ---
# router.py uploads images to services over multipart/form-data, so services can
# live off-box (a container, a remote GPU host) -- just point the URL at the host.
PADDLE_OCR_URL=http://127.0.0.1:8100/ocr
SERVICE_TIMEOUT=120

# --- Pluggable table backends (same POST-image -> {tables:[...]} contract) ----
# Point each URL where the service runs (local or a remote GPU tunnel). The
# pipeline (preprocess/verify/validate/export) is engine-agnostic.
TATR_TABLE_URL=http://127.0.0.1:8102/table
DOCLING_TABLE_URL=http://127.0.0.1:8103/table_tr
GEMMA_TABLE_URL=http://127.0.0.1:8101/table
PADDLEOCR_VL_URL=http://127.0.0.1:8104/table
HUNYUAN_TABLE_URL=http://127.0.0.1:8105/table
MINERU_TABLE_URL=http://127.0.0.1:8106/table

# Single-backend mode: tatr | docling | gemma | paddleocr_vl | hunyuan | mineru
TABLE_BACKEND=paddleocr_vl
# Two-model consensus mode (primary,secondary) -- cross-checks two readings.
CONSENSUS_BACKENDS=paddleocr_vl,hunyuan
# How ingest extracts tables: consensus (both models, same flow as the Excel
# deliverable) or single (one TABLE_BACKEND, when only one service is running).
INGEST_TABLE_MODE=consensus
# Columns tatr reads as Turkish text (EasyOCR-tr) instead of digits (PaddleOCR).
TATR_TEXT_COLS=1

# Image enhancement (deskew+contrast+upscale) is owned by the pipeline, so run
# backend services with PREPROCESS=0 to avoid double-enhancing.
PREPROCESS=1
# Tables with confidence <= this, OR any validation issue / model disagreement,
# are flagged needs_review for a human to check.
TABLE_REVIEW_THRESHOLD=0.9

# --- OpenWebUI-facing API (pipeline/api.py) ---
# Where generated xlsx files are written and served from.
EXPORT_DIR=./output/owui
# Base URL used in download links. OpenWebUI calls the API from inside its
# container (http://host.docker.internal:8000/v1), but the link is opened by the
# browser on the host -- so this is the host-side URL, not the container one.
PUBLIC_BASE_URL=http://localhost:8000
# Seconds between progress ticks while a streaming table extraction runs.
STREAM_TICK_SECONDS=5
